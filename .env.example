# Copy to .env and fill in. Free key: https://aistudio.google.com/apikey
# Optional — users can also paste their own key inside the AI Sous-Chef screen.
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_GEMINI_MODEL=gemini-3.5-flash-lite

# CookFlow REST API (repo SDN302/CookFlow). Leave empty for the defaults:
# Android emulator -> http://10.0.2.2:9999, iOS simulator / web -> http://localhost:9999.
# Real phone on the same Wi-Fi: use the computer's LAN IP, e.g. http://192.168.1.10:9999
EXPO_PUBLIC_API_URL=

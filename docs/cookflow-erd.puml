@startuml CookFlow-ERD
title CookFlow - Logical ERD (Frontend Data Model)
hide circle
skinparam linetype ortho
skinparam entity {
  BackgroundColor #FFF9F2
  BorderColor #E87543
  FontColor #292929
}

entity "Recipe" as Recipe {
  * id : TEXT <<PK>>
  --
  title : TEXT
  description : TEXT
  image_url : TEXT
  video_url : TEXT
  category : TEXT
  difficulty : TEXT
  prep_time_minutes : INTEGER
  cook_time_minutes : INTEGER
  servings : INTEGER
  calories : INTEGER
  tags : JSON
  is_custom : BOOLEAN
  created_at : DATETIME
  updated_at : DATETIME
}

entity "RecipeIngredient" as Ingredient {
  * recipe_id : TEXT <<PK, FK>>
  * ingredient_id : TEXT <<PK>>
  --
  name : TEXT
  amount : TEXT
  unit : TEXT
  group_name : TEXT
}

entity "RecipeStep" as Step {
  * recipe_id : TEXT <<PK, FK>>
  * step_id : TEXT <<PK>>
  --
  step_number : INTEGER
  title : TEXT
  instruction : TEXT
  timer_seconds : INTEGER
  tip : TEXT
  image_url : TEXT
  video_url : TEXT
}

entity "Favorite" as Favorite {
  * recipe_id : TEXT <<PK, FK>>
}

entity "PantryItem" as Pantry {
  * id : TEXT <<PK>>
  --
  name : TEXT
}

entity "ShoppingItem" as Shopping {
  * id : TEXT <<PK>>
  --
  name : TEXT
  amount : TEXT
  unit : TEXT
  recipe_title : TEXT
  checked : BOOLEAN
}

entity "CookingSession" as Session {
  * id : TEXT <<PK>>
  --
  recipe_id : TEXT <<FK>>
  servings : INTEGER
  step_id : TEXT <<FK>>
  step_index : INTEGER
  started_at : DATETIME
}

entity "CookingTimer" as Timer {
  * id : TEXT <<PK>>
  --
  recipe_id : TEXT <<FK>>
  step_id : TEXT <<FK>>
  step_index : INTEGER
  recipe_title : TEXT
  step_title : TEXT
  duration_seconds : INTEGER
  status : TEXT
  end_at : DATETIME
  remaining_seconds : INTEGER
}

entity "CookingHistory" as History {
  * id : TEXT <<PK>>
  --
  recipe_id : TEXT <<FK, nullable>>
  recipe_title : TEXT
  servings : INTEGER
  started_at : DATETIME
  finished_at : DATETIME
  rating : INTEGER
  note : TEXT
}

entity "UserSettings" as Settings {
  * id : TEXT <<PK>>
  --
  keep_awake : BOOLEAN
  timer_sound : BOOLEAN
  vibration : BOOLEAN
  timer_notifications : BOOLEAN
  assume_staples : BOOLEAN
  auto_stock_pantry : BOOLEAN
  hide_allergen_recipes : BOOLEAN
}

entity "SettingAllergy" as Allergy {
  * settings_id : TEXT <<PK, FK>>
  * allergen_id : TEXT <<PK>>
}

Recipe ||--o{ Ingredient : has
Recipe ||--o{ Step : has
Recipe ||--o{ Favorite : saved as
Recipe |o--o{ History : optional source
Recipe ||--o{ Timer : has timers
Recipe ||--o| Session : active session
Step ||--o| Timer : timed step
Step ||--o| Session : current step
Settings ||--o{ Allergy : excludes

note right of Recipe
  Category and difficulty are
  controlled values in the app.
  Tags, ingredients and steps are
  arrays in persisted JSON today.
end note

note bottom of Pantry
  Pantry is currently stored as
  a list of ingredient-name strings.
end note

note bottom of Shopping
  recipe_title is a source label,
  not a recipe foreign key.
end note

note bottom of History
  Recipe title is snapshotted.
  recipe_id can be absent if the
  source recipe is later removed.
end note

note bottom of Settings
  One local settings object; the
  frontend has no user/account table.
end note
@enduml
